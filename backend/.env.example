AI_PROVIDER=openai
OPENAI_API_KEY=replace_with_your_local_openai_key
OPENAI_MODEL=gpt-6-luna
OPENAI_MAX_OUTPUT_TOKENS=350
AUTO_WEEKLY_REPORT_INTERVAL_SECONDS=604800
TRIAGE_DB_PATH=triage.db
REPORTS_DIR=../reports

# ── Area interna: OBBLIGATORIE ────────────────────────────────────────────────
# Erano commentate, quindi sembravano facoltative, e infatti non sono mai state
# impostate: l'area interna restava aperta a chiunque. Ora senza queste l'API
# risponde 503 su segnalazioni, alert, dashboard e report.
INTERNAL_AUTH_USERNAME=
INTERNAL_AUTH_PASSWORD=

# Solo per lo sviluppo locale, e solo scritta di proposito. Mai in produzione.
# INTERNAL_AUTH_DISABLED=true

# ── CORS ──────────────────────────────────────────────────────────────────────
# Se la imposti valgono SOLO queste origini e localhost sparisce. In produzione
# va impostata: localhost sempre ammesso, con allow_credentials, e' una porta aperta.
# CORS_ALLOW_ORIGINS=https://tuo-dominio

# ── Honeypot ──────────────────────────────────────────────────────────────────
# Sale SEGRETO per l'impronta degli IP. Senza, ip_hash non anonimizza niente
# (gli IPv4 si invertono per forza bruta in secondi): l'app ora scrive
# "senza-sale" invece di registrare un'impronta che sembra protetta e non lo e'.
HONEYPOT_HASH_SALT=

# Header dell'IP reale, SOLO se davanti c'e' un proxy fidato che lo scrive lui.
# Senza, dietro un proxy il freno dell'assistente diventa un secchio unico per
# tutti: un utente ogni 5 secondi blocca il servizio a chiunque altro.
# Si legge l'ultimo valore dell'header, cioe' quello aggiunto dal proxy.
# TRUST_PROXY_HEADER=x-forwarded-for

# ── Limiti e avvio ────────────────────────────────────────────────────────────
# Oltre questo tetto l'assistente risponde dalle fonti locali, senza costi.
# AI_MAX_REQUESTS_PER_MINUTE=200
# Blocca l'avvio se i segreti sono deboli e spegne /docs. Attiva nell'immagine Docker.
# SECURITY_STRICT=true
